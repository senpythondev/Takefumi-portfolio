# dependencies
node_modules/

# Next.js / build output
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# env files (secrets). Only the non-secret example file is tracked.
.env*
!.env.example

# test & measurement artifacts
test-results/
# measurement output (budget / perf): Playwright empties test-results/ on every run, so it lives here
perf-results/
ab-results/
playwright-report/
blob-report/
playwright/.cache/
.lighthouseci/
coverage/
# review screenshots are regenerated with `npm run screenshots` (not committed)
docs/screenshots/

# Vercel
.vercel/

# Claude Code personal settings (agents in .claude/agents/ ARE tracked)
.claude/settings.local.json

# OS / editor / logs
.DS_Store
*.log

# Font sources for `npm run fonts` (OFL fonts, several MB each; only the generated subsets are committed)
.cache/

# Concept reference images (owner-generated visual targets, ~10 MB; not site assets)
docs/concept/**/*.png
# Reference-site captures and the owner's screenshots (third-party material; never committed)
docs/concept/references/
