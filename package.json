{
  "name": "ground-truth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "next dev",
    "prebuild": "npm run validate && npm run check:confidentiality",
    "build": "next build",
    "build:release": "GT_RELEASE=1 npm run build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "validate": "node scripts/validate-content.ts",
    "check:confidentiality": "node scripts/check-confidentiality.ts",
    "test:e2e": "playwright test --project=desktop --project=mobile --project=reduced-motion",
    "test:e2e:update": "playwright test --project=desktop --project=mobile --project=reduced-motion --update-snapshots",
    "budget": "playwright test --project=budget",
    "lhci": "lhci autorun",
    "screenshots": "node scripts/screenshots.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  }
}
